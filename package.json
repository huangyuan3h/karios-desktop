{
  "name": "karios-desktop",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ensure-ports": "node scripts/ensure-ports.mjs",
    "ensure-rsshub": "node scripts/ensure-rsshub.mjs",
    "predev": "pnpm ensure-ports && pnpm ensure-rsshub",
    "dev": "turbo dev",
    "install:all": "pnpm install && uv sync --project services/data-sync-service",
    "build": "turbo build",
    "test": "turbo test",
    "coverage": "turbo coverage && cd services/data-sync-service && uv run pytest",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier -w ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6"
  }
}
