# Karios Desktop — example environment variables for Docker compose.
#
# Usage:
#   cp .env.example .env
#   # Edit .env to fill in real API keys.
#   scripts/docker-up.sh
#
# DO NOT commit .env to git (already in .gitignore).
# All values shown are dev defaults; the docker-compose.yml falls back to these
# when the variable is unset.

# ---------- Postgres ----------
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=karios-desktop
POSTGRES_PORT=5432

# ---------- pgAdmin ----------
PGADMIN_DEFAULT_EMAIL=admin@localhost.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=8081

# ---------- RSSHub ----------
RSSHUB_PORT=1200
# If you're behind a corporate proxy in China, set this so RSSHub can reach the public web.
# Example: http://127.0.0.1:7890
RSSHUB_HTTP_PROXY=

# ---------- Data Sync Service ----------
DATA_SYNC_PORT=4330
TU_SHARE_API_KEY=
# Chrome capture (macOS only). Set to your host Chrome CDP endpoint.
# Default uses host.docker.internal which works on Docker Desktop for Mac.
TV_CHROME_CDP_URL=http://host.docker.internal:9222
# Optional AI service discovery.
AI_SERVICE_BASE_URL=http://ai-service:4310

# ---------- AI Service ----------
AI_SERVICE_PORT=4310
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=
AI_STRATEGY_FALLBACK_MODEL=
AI_TITLE_MODEL=

# ---------- Alpha Radar / RSS ----------
ALPHA_RADAR_RSSHUB_BASE_URL=http://rsshub:1200
ALPHA_RADAR_FILTER_STRICT=true
ALPHA_RADAR_CATALYST_MAX_AGE_DAYS=14
ALPHA_RADAR_PIPELINE_COOLDOWN_HOURS=12
ALPHA_RADAR_DAILY_BATCH_ROUNDS=4
ALPHA_RADAR_PROCESS_MAX_ROUNDS=4
ALPHA_RADAR_PROCESS_BATCH_SIZE=10
ALPHA_RADAR_TREND_RETENTION_DAYS=30
ALPHA_RADAR_PROCESS_INTERVAL_HOURS=2
ALPHA_RADAR_INGEST_INTERVAL_HOURS=1
ALPHA_RADAR_ENRICH_FULLTEXT=true
ALPHA_RADAR_MAX_ITEMS_PER_SOURCE=20
ALPHA_RADAR_FULLTEXT_MAX_PER_SOURCE=6
ALPHA_RADAR_RSS_TIMEOUT=20
ALPHA_RADAR_RSS_CLS_POLICY=
ALPHA_RADAR_RSS_GOV_MIIT=
ALPHA_RADAR_RSS_GOV_NDRC=
ALPHA_RADAR_RSS_WALLSTREETCN=
ALPHA_RADAR_RSS_EASTMONEY_COPPER=
ALPHA_RADAR_RSS_CLS_DEPTH=
TAVILY_API_KEY=
JINA_API_KEY=

# ---------- Desktop UI (build-time) ----------
# These are inlined into the Next.js bundle at build time.
# When using Cloudflare Tunnel or another reverse proxy, set these to the
# public hostnames; otherwise the defaults (localhost) are fine for local use.
NEXT_PUBLIC_DATA_SYNC_BASE_URL=http://127.0.0.1:4330
NEXT_PUBLIC_AI_BASE_URL=http://127.0.0.1:4310

# Host port for the nginx container (serves desktop-ui static export).
DESKTOP_UI_PORT=8080

# ---------- Karios API Keys (for /v1/*) ----------
# Comma-separated label:secret:rpm:rph:rpd triples. Empty = open access (dev only).
# Example:  default:devkey123:60:1000:10000,readonly:abc:30:200:2000
KARIOS_API_KEYS=
KARIOS_API_VERSION=0.1.0

# ---------- Proxy (used by data-sync and ai-service) ----------
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,postgres
NODE_USE_ENV_PROXY=true

# ---------- Auto-start ----------
# When scripts/install-launchd.sh installs the LaunchAgent, this controls
# whether the agent auto-starts on login.
KARIOS_AUTO_START_ON_LOGIN=true

# ---------- UPS ----------
# Path to the UPS shutdown script. Karios does NOT install this automatically.
# Configure your UPS monitor (nut / apcupsd) to call this script on low battery.
KARIOS_UPS_SHUTDOWN_HOOK=