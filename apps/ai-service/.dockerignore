# AI Service local .dockerignore
# Augments root .dockerignore when this directory is the build context.

node_modules/
coverage/
dist/
.turbo/
.cache/

# Tests live in CI.
src/**/*.test.ts
src/**/*.test.tsx
**/__tests__/

# IDE / OS.
.vscode/
.idea/
.DS_Store
*.log

# Local env files (NEVER bake secrets).
.env
.env.*
!.env.example