# Choose provider: "openai" or "google"
AI_PROVIDER=openai

# Provider API keys
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Model id depends on provider (examples only)
AI_MODEL=

# Optional: dedicated model for title generation (falls back to AI_MODEL)
AI_TITLE_MODEL=

# Optional: dedicated model for strategy JSON generation (falls back to AI_MODEL)
AI_STRATEGY_MODEL=

# Optional: fallback model for strategy generation when primary model fails to produce valid JSON
AI_STRATEGY_FALLBACK_MODEL=

# Optional: Vercel AI Gateway key — when set, alpha-radar routes (only)
# use the hardcoded free fin model (ALPHA_GATEWAY_MODEL_ID in src/model.ts).
# Everything else keeps AI_PROVIDER/AI_MODEL.
VERCEL_API_GATEWAY=

# Server config
PORT=4310

# News text generation driver
# - opencode (default): spawn the local OpenCode CLI model, bounded per request
# - profile: fall back to AI_PROVIDER / AI_MODEL / the active AI profile
NEWS_LLM_DRIVER=opencode
NEWS_LLM_MODEL=opencode-go/deepseek-v4.1-flash
NEWS_LLM_TIMEOUT_MS=180000

# OpenCode CLI driver details
# Override the binary if OpenCode lives elsewhere.
# NEWS_OPENCODE_BIN=/Users/huangyuan/.opencode/bin/opencode
# Proxy injected only into the spawned child (HTTPS_PROXY/HTTP_PROXY/ALL_PROXY).
NEWS_OPENCODE_PROXY=http://127.0.0.1:7897
# Working directory for the spawned run (kept outside the repo so no AGENTS.md
# or project config leaks into a news prompt). Defaults to the system temp dir.
# NEWS_OPENCODE_CWD=


