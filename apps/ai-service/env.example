# Choose provider: "openai" or "google"
AI_PROVIDER=openai

# Provider API keys
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Model id depends on provider (examples only)
AI_MODEL=

# Optional: dedicated model for title generation (falls back to AI_MODEL)
AI_TITLE_MODEL=

# Optional: dedicated model for strategy JSON generation (falls back to AI_MODEL)
AI_STRATEGY_MODEL=

# Optional: fallback model for strategy generation when primary model fails to produce valid JSON
AI_STRATEGY_FALLBACK_MODEL=

# Optional: Vercel AI Gateway key — when set, alpha-radar routes (only)
# use the hardcoded free fin model (ALPHA_GATEWAY_MODEL_ID in src/model.ts).
# Everything else keeps AI_PROVIDER/AI_MODEL.
VERCEL_API_GATEWAY=

# Server config
PORT=4310


